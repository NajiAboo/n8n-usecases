    {
      "parameters": {
        "promptType": "define",
        "text": "=Instructions:\n\nIf the user provides a valid order ID:\n\nExtract the order ID from the message.\n\nCall the get_order_info tool.\n\nPass the extracted order ID as the parameter for $1.\n\nDo NOT modify the SQL query.\n\nAfter receiving the tool response, present the order details clearly and professionally.\n\nDo NOT mention the tool name.\n\nDo NOT display SQL queries in the response.\n\nIf the user does NOT provide an order ID:\n\nPolitely ask the user to provide their order ID.\n\nDo NOT call the tool.\n\nIf the order ID is unclear or ambiguous:\n\nAsk for clarification.\n\nDo NOT guess or assume the order ID.\n\nKeep responses:\n\nFriendly\n\nClear\n\nProfessional\n\nConcise\n\nNever return JSON unless explicitly required.\n\n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
